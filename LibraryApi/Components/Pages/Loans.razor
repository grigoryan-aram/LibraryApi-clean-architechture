@page "/loans"
@attribute [Authorize]
@rendermode InteractiveServer

@using global::Application.Features.Books.Queries
@using global::Application.Features.Loans.Commands
@using global::Application.Features.Loans.Queries
@using global::Application.Features.Members.Queries
@inject IMediator Mediator

<PageTitle>Loans — Athenaeum</PageTitle>

<section class="page">

    <header class="page-head">
        <div>
            <h1>Loans</h1>
            <p class="muted">Who has what, joined against the books and members tables.</p>
        </div>

        <div class="stats">
            <div class="stat">
                <span class="stat-num">@_loans.Count</span>
                <span class="stat-label">total</span>
            </div>
            <div class="stat">
                <span class="stat-num stat-warn">@_loans.Count(l => !l.IsReturned)</span>
                <span class="stat-label">out now</span>
            </div>
            <div class="stat">
                <span class="stat-num stat-late">@_loans.Count(l => l.IsOverdue)</span>
                <span class="stat-label">overdue</span>
            </div>
            <div class="stat">
                <span class="stat-num stat-ok">@_loans.Count(l => l.IsReturned)</span>
                <span class="stat-label">returned</span>
            </div>
        </div>
    </header>

    @if (_error is not null)
    {
        <div class="alert alert-error" role="alert">@_error</div>
    }

    <form class="inline-form" @onsubmit="LendAsync" @onsubmit:preventDefault>
        <label class="field-inline">
            <span>Book</span>
            <select @bind="_newBookId">
                <option value="0">Pick a book…</option>
                @foreach (var book in _books.Where(b => b.IsAvailable).OrderBy(b => b.Title))
                {
                    <option value="@book.Id">
                        @book.Title (@book.AvailableCopies of @book.TotalCopies)
                    </option>
                }
            </select>
        </label>

        <label class="field-inline">
            <span>Member</span>
            <select @bind="_newMemberId">
                <option value="0">Pick a member…</option>
                @foreach (var member in _members.OrderBy(m => m.Name))
                {
                    <option value="@member.id">@member.Name</option>
                }
            </select>
        </label>

        <button class="btn btn-primary" type="submit" disabled="@_busy">Lend it out</button>
    </form>

    @if (_loading)
    {
        <p class="muted">Loading loans…</p>
    }
    else if (_loans.Count == 0)
    {
        <div class="empty">
            <span class="empty-glyph">◇</span>
            <p>No loans on record.</p>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>Book</th>
                        <th>Member</th>
                        <th>Borrowed</th>
                        <th>Due</th>
                        <th>Returned</th>
                        <th>Status</th>
                        <th class="right">—</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var loan in _loans.OrderByDescending(l => l.BorrowedAt))
                    {
                        <tr>
                            <td class="strong" data-label="Book">@BookTitle(loan.BookId)</td>
                            <td data-label="Member">@MemberName(loan.MemberId)</td>
                            <td class="mono" data-label="Borrowed">@loan.BorrowedAt.ToString("yyyy-MM-dd")</td>
                            <td class="mono" data-label="Due">@loan.DueAt.ToString("yyyy-MM-dd")</td>
                            <td class="mono" data-label="Returned">@(loan.ReturnedAt?.ToString("yyyy-MM-dd") ?? "—")</td>
                            <td data-label="Status">
                                @* IsOverdue and DaysOverdue are computed on LoansDTO, so this
                                   page and GET /api/Loans/overdue can never disagree. *@
                                @if (loan.IsOverdue)
                                {
                                    <span class="badge badge-late">
                                        @* DaysOverdue floors, so a book late by hours reads 0. *@
                                        @(loan.DaysOverdue == 0
                                            ? "overdue"
                                            : $"{loan.DaysOverdue} {(loan.DaysOverdue == 1 ? "day" : "days")} overdue")
                                    </span>
                                }
                                else if (!loan.IsReturned)
                                {
                                    <span class="badge badge-warn">out</span>
                                }
                                else
                                {
                                    <span class="badge badge-ok">returned</span>
                                }
                            </td>
                            <td class="right">
                                @if (!loan.IsReturned)
                                {
                                    <button class="btn btn-ghost btn-sm" title="Mark this book returned"
                                            disabled="@_busy" @onclick="() => ReturnAsync(loan)">
                                        Return
                                    </button>
                                }
                                <button class="btn-icon" title="Delete this loan record"
                                        disabled="@_busy" @onclick="() => DeleteAsync(loan)">
                                    ✕
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <p class="fineprint muted">
            <strong>Return</strong> sends <code>ReturnLoanCommand</code>, the same thing
            <code>POST /api/Loans/{id}/return</code> does — the server stamps the date.
            <strong>✕</strong> deletes the record outright, which is not the same as
            returning a book and leaves no trace that the loan happened.
        </p>
    }

</section>

@code {
    private List<LoansDTO> _loans = [];
    private List<BooksDTO> _books = [];
    private List<MembersDTO> _members = [];

    private int _newBookId;
    private int _newMemberId;
    private bool _loading = true;
    private bool _busy;
    private string? _error;

    private string BookTitle(int bookId) =>
        _books.FirstOrDefault(b => b.Id == bookId)?.Title ?? $"book #{bookId}";

    private string MemberName(int memberId) =>
        _members.FirstOrDefault(m => m.id == memberId)?.Name ?? $"member #{memberId}";

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;

        var loans = await Mediator.Send(new GetAllLoansQuery());
        var books = await Mediator.Send(new GetAllBooksQuery());
        var members = await Mediator.Send(new GetAllMembersQuery());

        _loans = loans.IsError ? [] : loans.Value.ToList();
        _books = books.IsError ? [] : books.Value.ToList();
        _members = members.IsError ? [] : members.Value.ToList();

        _error = loans.IsError ? loans.FirstError.Description : null;
        _loading = false;
    }

    private async Task LendAsync()
    {
        if (_newBookId == 0 || _newMemberId == 0)
        {
            _error = "Pick both a book and a member.";
            return;
        }

        _busy = true;
        _error = null;

        // No dates: the handler stamps BorrowedAt and works DueAt out from the
        // configured loan period.
        var result = await Mediator.Send(new AddLoanCommand(
            _newBookId,
            _newMemberId));

        if (result.IsError)
        {
            _error = result.FirstError.Description;
        }
        else
        {
            _newBookId = 0;
            _newMemberId = 0;
            await LoadAsync();
        }

        _busy = false;
    }

    private async Task ReturnAsync(LoansDTO loan)
    {
        _busy = true;
        _error = null;

        var result = await Mediator.Send(new ReturnLoanCommand(loan.Id));

        if (result.IsError)
        {
            _error = result.FirstError.Description;
        }
        else
        {
            await LoadAsync();
        }

        _busy = false;
    }

    private async Task DeleteAsync(LoansDTO loan)
    {
        _busy = true;
        _error = null;

        var result = await Mediator.Send(new DeleteLoanCommand(loan.Id));

        if (result.IsError)
        {
            _error = result.FirstError.Description;
        }
        else
        {
            await LoadAsync();
        }

        _busy = false;
    }
}
