@page "/account"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject IMediator Mediator
@inject NavigationManager Nav

@* Deliberately NOT interactive. Signing in writes an auth cookie, and a
   Blazor circuit has no response left to write headers on — so these forms
   are plain static-SSR posts, the same shape the Identity templates use. *@

<PageTitle>Account — Athenaeum</PageTitle>

<section class="account">

    <header class="account-head">
        <h1>Account</h1>
        <p class="muted">
            The cookie minted here is the same one <code>/api/Auth/login</code>
            issues — it authorises the API, Swagger and the chat circuit alike.
        </p>
    </header>

    <AuthorizeView Context="auth">
        <Authorized>
            <div class="panel panel-single">
                <span class="panel-glyph">✓</span>
                <h2>Signed in as @auth.User.Identity?.Name</h2>

                @if (auth.User.IsInRole(Roles.Admin))
                {
                    <p class="muted">
                        You hold the <strong>@Roles.Admin</strong> role — the Swagger UI and the
                        Hangfire dashboard are open to you as well.
                    </p>
                }
                else
                {
                    <p class="muted">
                        The chat page and every <code>[Authorize]</code> endpoint are open to you.
                        <code>/swagger</code> and <code>/hangfire</code> need the
                        <strong>@Roles.Admin</strong> role, which only the startup seeder grants.
                    </p>
                }

                <div class="panel-actions">
                    <a class="btn btn-primary" href="chat">Go to the chat</a>

                    <form method="post" @formname="logout" @onsubmit="SignOutAsync">
                        <AntiforgeryToken />
                        <button class="btn btn-ghost" type="submit">Sign out</button>
                    </form>
                </div>
            </div>
        </Authorized>

        <NotAuthorized>
            <div class="panels">

                <div class="panel">
                    <span class="panel-glyph">→</span>
                    <h2>Sign in</h2>

                    @if (_loginError is not null)
                    {
                        <div class="alert alert-error" role="alert">@_loginError</div>
                    }

                    <EditForm Model="LoginModel" FormName="login" OnValidSubmit="SignInAsync" method="post">
                        <DataAnnotationsValidator />

                        <label class="field">
                            <span>Username</span>
                            <InputText @bind-Value="LoginModel!.Username" autocomplete="username" />
                            <ValidationMessage For="() => LoginModel!.Username" />
                        </label>

                        <label class="field">
                            <span>Password</span>
                            <InputText type="password" @bind-Value="LoginModel!.Password" autocomplete="current-password" />
                            <ValidationMessage For="() => LoginModel!.Password" />
                        </label>

                        <button class="btn btn-primary btn-block" type="submit">Sign in</button>
                    </EditForm>

                    <a class="link-quiet" href="account#reset">Forgotten your password?</a>
                </div>

                <div class="panel">
                    <span class="panel-glyph">✦</span>
                    <h2>Create an account</h2>

                    @if (_registerErrors.Count > 0)
                    {
                        <div class="alert alert-error" role="alert">
                            @foreach (var error in _registerErrors)
                            {
                                <div>@error</div>
                            }
                        </div>
                    }

                    @if (_registerSuccess is not null)
                    {
                        <div class="alert alert-ok" role="status">@_registerSuccess</div>
                    }

                    <EditForm Model="RegisterModel" FormName="register" OnValidSubmit="RegisterAsync" method="post">
                        <DataAnnotationsValidator />

                        <label class="field">
                            <span>Username</span>
                            <InputText @bind-Value="RegisterModel!.Username" autocomplete="username" />
                            <ValidationMessage For="() => RegisterModel!.Username" />
                        </label>

                        <label class="field">
                            <span>Email</span>
                            <InputText @bind-Value="RegisterModel!.Email" autocomplete="email" />
                            <ValidationMessage For="() => RegisterModel!.Email" />
                        </label>

                        <label class="field">
                            <span>Password</span>
                            <InputText type="password" @bind-Value="RegisterModel!.Password" autocomplete="new-password" />
                            <ValidationMessage For="() => RegisterModel!.Password" />
                        </label>

                        <button class="btn btn-ghost btn-block" type="submit">Register</button>
                    </EditForm>

                    <p class="fineprint muted">
                        Registration runs through <code>RegisterCommand</code> and queues the
                        welcome email as a Hangfire job — exactly as the API does.
                    </p>
                </div>

            </div>

            <div class="panel panel-single panel-reset" id="reset">
                <span class="panel-glyph">⟲</span>
                <h2>Forgotten your password?</h2>

                @if (_resetErrors.Count > 0)
                {
                    <div class="alert alert-error" role="alert">
                        @foreach (var error in _resetErrors)
                        {
                            <div>@error</div>
                        }
                    </div>
                }

                @if (_forgotMessage is not null)
                {
                    <div class="alert alert-ok" role="status">@_forgotMessage</div>
                }

                @if (_resetSuccess is not null)
                {
                    <div class="alert alert-ok" role="status">@_resetSuccess</div>
                }

                @* Both steps are always on the page rather than one replacing
                   the other: this form is static-SSR, so a step that only
                   appeared after the first post would be lost on a refresh —
                   and someone returning with a code already in their inbox
                   would have no way back to it. *@
                <div class="panel-steps">
                    <div>
                        <span class="step-label">Step one — get a code</span>

                        <EditForm Model="ForgotModel" FormName="forgot-password"
                                  OnValidSubmit="RequestCodeAsync" method="post">
                            <DataAnnotationsValidator />

                            <label class="field">
                                <span>Email</span>
                                <InputText @bind-Value="ForgotModel!.Email" autocomplete="email" />
                                <ValidationMessage For="() => ForgotModel!.Email" />
                            </label>

                            <button class="btn btn-ghost btn-block" type="submit">Email me a code</button>
                        </EditForm>
                    </div>

                    <div>
                        <span class="step-label">Step two — use it</span>

                        <EditForm Model="ResetModel" FormName="reset-password"
                                  OnValidSubmit="ResetPasswordAsync" method="post">
                            <DataAnnotationsValidator />

                            <label class="field">
                                <span>Email</span>
                                <InputText @bind-Value="ResetModel!.Email" autocomplete="email" />
                                <ValidationMessage For="() => ResetModel!.Email" />
                            </label>

                            <label class="field">
                                <span>Code from the email</span>
                                <InputText @bind-Value="ResetModel!.Code" autocomplete="one-time-code"
                                           placeholder="VK35oeQ" />
                                <ValidationMessage For="() => ResetModel!.Code" />
                            </label>

                            <label class="field">
                                <span>New password</span>
                                <InputText type="password" @bind-Value="ResetModel!.NewPassword"
                                           autocomplete="new-password" />
                                <ValidationMessage For="() => ResetModel!.NewPassword" />
                            </label>

                            <button class="btn btn-primary btn-block" type="submit">Change my password</button>
                        </EditForm>
                    </div>
                </div>

                <p class="fineprint muted">
                    The code lasts @PasswordResetRules.ExpiryMinutes minutes, works once, and
                    allows @PasswordResetRules.MaxAttempts tries. Capital letters do not matter.
                </p>
            </div>
        </NotAuthorized>
    </AuthorizeView>

</section>

@code {
    // Nullable, with no property initializer, and filled in OnInitialized
    // instead — the shape BL0008 asks for. On a form post the framework
    // assigns these from the posted fields, and an initializer here is not a
    // fallback: the assignment happens afterwards and can put null straight
    // over it. Only the form actually being submitted is bound, so the OTHER
    // model on this page is the one that would arrive null.
    [SupplyParameterFromForm(FormName = "login")]
    private LoginInput? LoginModel { get; set; }

    [SupplyParameterFromForm(FormName = "register")]
    private RegisterInput? RegisterModel { get; set; }

    [SupplyParameterFromForm(FormName = "forgot-password")]
    private ForgotInput? ForgotModel { get; set; }

    [SupplyParameterFromForm(FormName = "reset-password")]
    private ResetInput? ResetModel { get; set; }

    protected override void OnInitialized()
    {
        // ??= not =, so a bound model survives: this runs after binding.
        LoginModel ??= new LoginInput();
        RegisterModel ??= new RegisterInput();
        ForgotModel ??= new ForgotInput();
        ResetModel ??= new ResetInput();
    }

    private string? _loginError;
    private string? _registerSuccess;
    private List<string> _registerErrors = [];
    private string? _forgotMessage;
    private string? _resetSuccess;
    private List<string> _resetErrors = [];

    private async Task SignInAsync()
    {
        var result = await SignInManager.PasswordSignInAsync(
            LoginModel!.Username,
            LoginModel!.Password,
            isPersistent: false,
            lockoutOnFailure: false);

        if (!result.Succeeded)
        {
            _loginError = "Invalid username or password.";
            return;
        }

        Nav.NavigateTo("chat");
    }

    private async Task RegisterAsync()
    {
        _registerErrors = [];
        _registerSuccess = null;

        var result = await Mediator.Send(new RegisterCommand(
            RegisterModel!.Username,
            RegisterModel!.Password,
            RegisterModel!.Email));

        if (result.IsError)
        {
            _registerErrors = result.Errors.Select(error => error.Description).ToList();
            return;
        }

        _registerSuccess = $"Welcome, {result.Value.Username}. You can sign in now.";
        RegisterModel = new RegisterInput();
    }

    private async Task RequestCodeAsync()
    {
        _resetErrors = [];
        _resetSuccess = null;
        _forgotMessage = null;

        var result = await Mediator.Send(new ForgotPasswordCommand(ForgotModel!.Email));

        if (result.IsError)
        {
            _resetErrors = result.Errors.Select(error => error.Description).ToList();
            return;
        }

        // The same sentence whatever the address, because the handler behaves
        // the same way — saying "we sent it" only for real accounts would give
        // the page away as an account-enumeration tool.
        _forgotMessage =
            $"If that address has an account, a code is on its way. " +
            $"It expires in {PasswordResetRules.ExpiryMinutes} minutes.";

        ResetModel!.Email = ForgotModel!.Email;
    }

    private async Task ResetPasswordAsync()
    {
        _resetErrors = [];
        _resetSuccess = null;
        _forgotMessage = null;

        var result = await Mediator.Send(new ResetPasswordCommand(
            ResetModel!.Email,
            ResetModel!.Code,
            ResetModel!.NewPassword));

        if (result.IsError)
        {
            _resetErrors = result.Errors.Select(error => error.Description).ToList();
            return;
        }

        _resetSuccess = "Password changed. Sign in with your new password.";
        ResetModel = new ResetInput();
    }

    private async Task SignOutAsync()
    {
        await SignInManager.SignOutAsync();
        Nav.NavigateTo("", forceLoad: true);
    }

    private sealed class LoginInput
    {
        [Required(ErrorMessage = "Username is required.")]
        public string Username { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required.")]
        public string Password { get; set; } = string.Empty;
    }

    private sealed class ForgotInput
    {
        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "That does not look like an email address.")]
        public string Email { get; set; } = string.Empty;
    }

    private sealed class ResetInput
    {
        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "That does not look like an email address.")]
        public string Email { get; set; } = string.Empty;

        // No length rule here. ResetPasswordCommandValidator owns it, and two
        // copies of the number would drift the day the code length changes.
        [Required(ErrorMessage = "The code from the email is required.")]
        public string Code { get; set; } = string.Empty;

        // Strength is Identity's to judge, for the same reason.
        [Required(ErrorMessage = "A new password is required.")]
        public string NewPassword { get; set; } = string.Empty;
    }

    private sealed class RegisterInput
    {
        [Required(ErrorMessage = "Username is required.")]
        [MinLength(3, ErrorMessage = "Username must be at least 3 characters long.")]
        public string Username { get; set; } = string.Empty;

        [Required(ErrorMessage = "Email is required.")]
        [EmailAddress(ErrorMessage = "That does not look like an email address.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Password is required.")]
        public string Password { get; set; } = string.Empty;
    }
}
