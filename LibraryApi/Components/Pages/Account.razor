@page "/account"

@using System.ComponentModel.DataAnnotations
@using System.Security.Claims
@using Microsoft.AspNetCore.Identity
@using global::Application.Features.Accounts
@inject SignInManager<IdentityUser> SignInManager
@inject IMediator Mediator
@inject NavigationManager Nav

@* Static-SSR, like the sign-in page: signing out clears the auth cookie, and
   a Blazor circuit has no response left to write headers on. *@

<PageTitle>Account — Athenaeum</PageTitle>

<section class="account">

    <header class="account-head">
        <h1>Account</h1>
        <p class="muted">
            The cookie minted at sign-in is the same one <code>/api/Auth/login</code>
            issues — it authorises the API, Swagger and the chat circuit alike.
        </p>
    </header>

    <AuthorizeView Context="auth">
        <Authorized>
            <div class="panel panel-single">
                <span class="panel-glyph">✓</span>
                <h2>Signed in as @auth.User.Identity?.Name</h2>

                @if (auth.User.IsInRole(Roles.Admin))
                {
                    <p class="muted">
                        You hold the <strong>@Roles.Admin</strong> role — the Swagger UI and the
                        Hangfire dashboard are open to you as well.
                    </p>
                }
                else
                {
                    <p class="muted">
                        The chat page and every <code>[Authorize]</code> endpoint are open to you.
                        <code>/swagger</code> and <code>/hangfire</code> need the
                        <strong>@Roles.Admin</strong> role, which only the startup seeder grants.
                    </p>
                }

                <div class="panel-actions">
                    <a class="btn btn-primary" href="chat">Go to the chat</a>

                    <form method="post" @formname="logout" @onsubmit="SignOutAsync">
                        <AntiforgeryToken />
                        <button class="btn btn-ghost" type="submit">Sign out</button>
                    </form>
                </div>

                @* <details> keeps each form folded away without needing an
                   interactive circuit; it opens itself again after a submit so
                   the outcome is visible. *@
                <details class="account-section" open="@(_passwordPosted || PasswordChanged)">
                    <summary>Change password</summary>

                    @if (PasswordChanged)
                    {
                        <div class="alert alert-ok" role="status">
                            Password changed. Your other signed-in sessions will be signed out within a minute.
                        </div>
                    }

                    @if (_passwordError is not null)
                    {
                        <div class="alert alert-error" role="alert">@_passwordError</div>
                    }

                    <EditForm Model="PasswordModel" FormName="change-password" OnValidSubmit="ChangePasswordAsync" OnInvalidSubmit="() => _passwordPosted = true" method="post">
                        <DataAnnotationsValidator />

                        <label class="field">
                            <span>Current password</span>
                            <InputText type="password" @bind-Value="PasswordModel!.CurrentPassword" autocomplete="current-password" />
                            <ValidationMessage For="() => PasswordModel!.CurrentPassword" />
                        </label>

                        <label class="field">
                            <span>New password</span>
                            <InputText type="password" @bind-Value="PasswordModel!.NewPassword" autocomplete="new-password" />
                            <ValidationMessage For="() => PasswordModel!.NewPassword" />
                        </label>

                        <label class="field">
                            <span>Confirm new password</span>
                            <InputText type="password" @bind-Value="PasswordModel!.ConfirmPassword" autocomplete="new-password" />
                            <ValidationMessage For="() => PasswordModel!.ConfirmPassword" />
                        </label>

                        <button class="btn btn-primary btn-block" type="submit">Change password</button>
                    </EditForm>
                </details>

                @if (!auth.User.IsInRole(Roles.Admin))
                {
                    <details class="account-section danger-zone" open="@_deletePosted">
                        <summary>Delete account</summary>

                        <p class="muted">
                            This removes your sign-in for good. Any books you have out must be
                            returned first. Your past loans stay on the library's records, but
                            no longer under your name.
                        </p>

                        @if (_deleteError is not null)
                        {
                            <div class="alert alert-error" role="alert">@_deleteError</div>
                        }

                        <EditForm Model="DeleteModel" FormName="delete-account" OnValidSubmit="DeleteAccountAsync" OnInvalidSubmit="() => _deletePosted = true" method="post">
                            <DataAnnotationsValidator />

                            <label class="field">
                                <span>Confirm with your password</span>
                                <InputText type="password" @bind-Value="DeleteModel!.Password" autocomplete="current-password" />
                                <ValidationMessage For="() => DeleteModel!.Password" />
                            </label>

                            <button class="btn btn-danger btn-block" type="submit">Delete my account</button>
                        </EditForm>
                    </details>
                }
            </div>
        </Authorized>

        <NotAuthorized>
            <div class="panel panel-single">
                @if (Deleted)
                {
                    <div class="alert alert-ok" role="status">Your account has been deleted.</div>
                }

                <span class="panel-glyph">→</span>
                <h2>You are not signed in</h2>

                <div class="panel-actions">
                    <a class="btn btn-primary" href="login">Sign in</a>
                    <a class="btn btn-ghost" href="register">Create an account</a>
                </div>

                <nav class="panel-links">
                    <a href="forgot-password">Forgotten your password?</a>
                </nav>
            </div>
        </NotAuthorized>
    </AuthorizeView>

</section>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    [SupplyParameterFromQuery(Name = "deleted")]
    private bool Deleted { get; set; }

    // Same shape as LoginModel on /login — see the comment there.
    [SupplyParameterFromForm(FormName = "delete-account")]
    private DeleteAccountInput? DeleteModel { get; set; }

    private string? _deleteError;

    // Set by either submit handler, valid or not, so the section reopens
    // with its validation messages or result showing.
    private bool _deletePosted;

    [SupplyParameterFromQuery(Name = "passwordChanged")]
    private bool PasswordChanged { get; set; }

    [SupplyParameterFromForm(FormName = "change-password")]
    private ChangePasswordInput? PasswordModel { get; set; }

    private string? _passwordError;

    private bool _passwordPosted;

    protected override void OnInitialized()
    {
        DeleteModel ??= new DeleteAccountInput();
        PasswordModel ??= new ChangePasswordInput();
    }

    private async Task ChangePasswordAsync()
    {
        _passwordPosted = true;

        var state = await AuthenticationState!;
        var identityUserId = state.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;

        // Same handler as POST /api/Auth/change-password. It re-issues this
        // request's cookie, which works because this is a static-SSR post.
        var result = await Mediator.Send(new ChangePasswordCommand(
            identityUserId,
            PasswordModel!.CurrentPassword,
            PasswordModel!.NewPassword));

        if (result.IsError)
        {
            // Identity can list several unmet rules at once; show them all.
            _passwordError = string.Join(" ", result.Errors.Select(error => error.Description));
            return;
        }

        // Redirect rather than re-render, so a refresh cannot re-post the form.
        Nav.NavigateTo("account?passwordChanged=true", forceLoad: true);
    }

    private async Task SignOutAsync()
    {
        await SignInManager.SignOutAsync();
        Nav.NavigateTo("", forceLoad: true);
    }

    private async Task DeleteAccountAsync()
    {
        _deletePosted = true;

        var state = await AuthenticationState!;

        // From the cookie, never the form — see DeleteAccountCommand.
        var identityUserId = state.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;

        // Same handler as POST /api/Auth/delete-account. It signs the caller
        // out itself; this is a static-SSR post, so the response is still open
        // for the cookie to be cleared on.
        var result = await Mediator.Send(new DeleteAccountCommand(
            identityUserId,
            DeleteModel!.Password));

        if (result.IsError)
        {
            _deleteError = result.FirstError.Description;
            return;
        }

        Nav.NavigateTo("account?deleted=true", forceLoad: true);
    }

    private sealed class ChangePasswordInput
    {
        [Required(ErrorMessage = "Enter your current password.")]
        public string CurrentPassword { get; set; } = string.Empty;

        [Required(ErrorMessage = "Enter a new password.")]
        public string NewPassword { get; set; } = string.Empty;

        // Page-only: a typo in a field you cannot see would lock you out.
        [Compare(nameof(NewPassword), ErrorMessage = "The two new passwords do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }

    private sealed class DeleteAccountInput
    {
        [Required(ErrorMessage = "Enter your password to confirm.")]
        public string Password { get; set; } = string.Empty;
    }
}
